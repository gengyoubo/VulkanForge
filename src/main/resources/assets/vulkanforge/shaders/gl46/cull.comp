#version 460 core
layout(local_size_x = 64) in;
layout(std140, binding = 0) uniform Frame {
    mat4 viewProjection;
    ivec4 cameraBlock;
    vec4 cameraFraction;
    vec4 fogColor;
    vec4 fog;
    uvec4 counts;  // x: section slots, y: command capacity per layer
};
// draw: x first vertex of the section's opaque quads, then y solid, z cutoutMipped, w cutout quad counts.
struct Section { ivec4 origin; vec4 minimum; vec4 maximum; uvec4 draw; };
struct Command { uint count; uint instanceCount; uint firstIndex; int baseVertex; uint baseInstance; };
layout(std430, binding = 0) readonly buffer Sections { Section sections[]; };
layout(std430, binding = 1) writeonly buffer Commands { Command commands[]; };
layout(std430, binding = 2) buffer Counts { uint drawCounts[3]; };
// Frustum test per section slot; each visible layer gets a DrawElementsIndirectCommand over the shared quad index buffer
// in that layer's command list, plus a GPU draw count for glMultiDrawElementsIndirectCount.
void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= counts.x) return;
    Section section = sections[index];
    if (section.draw.y + section.draw.z + section.draw.w == 0u) return;
    vec3 base = vec3(section.origin.xyz - cameraBlock.xyz) - cameraFraction.xyz;
    uint outside = 63u;
    for (uint corner = 0u; corner < 8u; corner++) {
        vec3 position = base + vec3((corner & 1u) == 0u ? section.minimum.x : section.maximum.x,
                                    (corner & 2u) == 0u ? section.minimum.y : section.maximum.y,
                                    (corner & 4u) == 0u ? section.minimum.z : section.maximum.z);
        vec4 clip = viewProjection * vec4(position, 1.0);
        outside &= (clip.x < -clip.w ? 1u : 0u) | (clip.x > clip.w ? 2u : 0u)
                 | (clip.y < -clip.w ? 4u : 0u) | (clip.y > clip.w ? 8u : 0u)
                 | (clip.z < -clip.w ? 16u : 0u) | (clip.z > clip.w ? 32u : 0u);
    }
    if (outside != 0u) return;
    uint first = section.draw.x;
    uint quads[3] = uint[3](section.draw.y, section.draw.z, section.draw.w);
    for (uint layer = 0u; layer < 3u; layer++) {
        if (quads[layer] == 0u) continue;
        uint slot = atomicAdd(drawCounts[layer], 1u);
        commands[layer * counts.y + slot] = Command(quads[layer] * 6u, 1u, 0u, int(first), index);
        first += quads[layer] * 4u;
    }
}

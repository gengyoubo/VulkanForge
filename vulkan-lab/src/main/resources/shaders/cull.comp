#version 450
layout(local_size_x=64) in;
struct Bounds { vec4 minimum; vec4 maximum; uvec4 draw; };
layout(std430, binding=0) readonly buffer Input { Bounds sections[]; };
layout(std430, binding=1) writeonly buffer Output { uvec4 commands[]; };
layout(push_constant) uniform View { mat4 viewProjection; uint count; } view;
void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= view.count) return;
    Bounds bounds = sections[index];
    uint outside = 63u;
    for (uint corner=0u; corner<8u; corner++) {
        vec3 position = vec3((corner & 1u) == 0u ? bounds.minimum.x : bounds.maximum.x,
                             (corner & 2u) == 0u ? bounds.minimum.y : bounds.maximum.y,
                             (corner & 4u) == 0u ? bounds.minimum.z : bounds.maximum.z);
        vec4 clip = view.viewProjection * vec4(position, 1.0);
        uint mask = (clip.x < -clip.w ? 1u : 0u) | (clip.x > clip.w ? 2u : 0u)
                  | (clip.y < -clip.w ? 4u : 0u) | (clip.y > clip.w ? 8u : 0u)
                  | (clip.z < -clip.w ? 16u : 0u) | (clip.z > clip.w ? 32u : 0u);
        outside &= mask;
    }
    commands[index] = uvec4(outside == 0u ? bounds.draw.x : 0u, 1u, 0u, 0u);
}
